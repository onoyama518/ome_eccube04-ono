{% extends 'default_frame.twig' %}

{% block main %}
<script>
//リストに切り替え
$(function() {
jQuery('#ac-eyeliner--black').addClass('active');
jQuery('.ac-eyeliner--black').addClass('active');
  $('.productslist').on('click', function() {
    var tabWrap = $(this).parents('.ac-eyeliner_lp--products');
    var tabBtn = tabWrap.find(".productslist");
    var tabContents = tabWrap.find('.ac-eyeliner--productslist');
    tabBtn.removeClass('active');
    $(this).addClass('active');
    var elmIndex = tabBtn.index(this);
    tabContents.removeClass('active');
    tabContents.eq(elmIndex).addClass('active');
  });
});
</script>

