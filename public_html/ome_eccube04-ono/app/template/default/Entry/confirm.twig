{% extends 'default_frame.twig' %}

{% set body_class = 'registration_page' %}

{% form_theme form 'Form/form_div_layout.twig' %}

{% block main %}
	<div id="undercolumn" class="page_entry_confirm">
		<div id="undercolumn_entry">
			<h2 class="title">会員登録(確認ページ)</h2>
			<p >下記の内容で送信してもよろしいでしょうか？<br/>
				よろしければ、一番下の「会員登録をする」ボタンをクリックしてください。</p>
			<form method="post" action="{{ url('entry') }}">

				{{ form_widget(form._token) }}

				<span class="p-country-name" style="display:none;">Japan</span>
				<table summary="会員登録確認" class="hyou">

					<colgroup width="30%"></colgroup>
					<colgroup width="70%"></colgroup>

					<tr>
						<th>会社名・サロン名
						</th>
						<td>
							{{ form.company_name.vars.data }}
							{{ form_widget(form.company_name, { type : 'hidden' }) }}
						</td>
					</tr>

					<tr>
						<th>お名前
						</th>
						<td>
							{{ form.name.name01.vars.data }}
							{# form.vars.value = form.vars.data = Customer #}
							{{ form.name.name02.vars.data }}
							{{ form_widget(form.name.name01, { type : 'hidden' }) }}
							{{ form_widget(form.name.name02, { type : 'hidden' }) }}
						</td>
					</tr>
					<tr>
						<th>お名前(フリガナ)
						</th>
						<td>
							{{ form.kana.kana01.vars.data }}
							{{ form.kana.kana02.vars.data }}
							{{ form_widget(form.kana.kana01, { type : 'hidden' }) }}
							{{ form_widget(form.kana.kana02, { type : 'hidden' }) }}
						</td>
					</tr>


					<tr>
						<th>住所
						</th>
						<td>
							<span>{{ '〒'|trans }}</span>
							{{ form.postal_code.vars.data }}
							{{ form.address.pref.vars.data }}
							{{ form.address.addr01.vars.data }}
							{{ form.address.addr02.vars.data }}
							{{ form_widget(form.postal_code, { type : 'hidden' }) }}
							{{ form_widget(form.address.pref, { type : 'hidden' }) }}
							{{ form_widget(form.address.addr01, { type : 'hidden' }) }}
							{{ form_widget(form.address.addr02, { type : 'hidden' }) }}</td>
					</tr>

					<tr>
						<th>電話番号<span class="attention">※</span>
						</th>
						<td>
							{{ form.phone_number.vars.data|e }}
							{{ form_widget(form.phone_number, { type: 'hidden' }) }}
						</td>
					</tr>

					{# ここにFAXの表示を移動 #}
					<tr>
						<th>FAX番号</th>
						<td>
							{{ form.fax.vars.data }} {# vars.data を使って表示 #}
							{{ form_widget(form.fax, { type: 'hidden' }) }} {# フォームデータを hidden フィールドとして保持 #}
						</td>
					</tr>

					<tr>
						<th>メールアドレス
						</th>
						<td>
							{{ form.email.vars.data }}
							{{ form_widget(form.email.first, { type : 'hidden' }) }}
							{{ form_widget(form.email.second, { type : 'hidden' }) }}
						</td>
					</tr>

					<tr>
						<th>性別
						</th>
						<td>
							{{ form.sex.vars.data }}
							{{ form_widget(form.sex, { type: 'hidden'}) }}
						</td>
					</tr>
					<tr>
						<th>生年月日</th>
						<td>
							{{ form.birth.vars.data ? form.birth.vars.data|date_day() }}
							{{ form_widget(form.birth.year, { type : 'hidden' }) }}
							{{ form_widget(form.birth.month, { type : 'hidden' }) }}
							{{ form_widget(form.birth.day, { type : 'hidden' }) }}
						</td>
					</tr>
					<tr>
						<th>希望するパスワード<br/>
						</th>
						<td>
							********
							{{ form_widget(form.plain_password.first, { type : 'hidden' }) }}
							{{ form_widget(form.plain_password.second, { type : 'hidden' }) }}
						</td>
					</tr>
				{% for f in form|filter(f => f.vars.eccube_form_options.auto_render and f.vars.name != 'fax') %}
					{% if f.vars.eccube_form_options.form_theme %}
						{% form_theme f f.vars.eccube_form_options.form_theme %}
						{{ form_row(f) }}
					{% else %}
						<tr>
							<th>
								{% set label_class = f.vars.label_attr.class is defined ? f.vars.label_attr.class : '' %}
								{{ form_label(f, f.vars.label, { 'label_attr': {'class': label_class ~ ' ec-label' }}) }}
							</th>
							<dd>
								<div class="{{ f.vars.eccube_form_options.style_class }}{{ has_errors(f) ? ' error' }}">
									{{ form_widget(f) }}
									{{ form_errors(f) }}
								</div>
							</dd>
						</tr>
					{% endif %}
				{% endfor %}

				</table>

				<div class="btn_area">
					<ul>
						<div class="ec-registerRole__actions">
							<div class="ec-off4Grid">
								<div class="ec-off4Grid__cell">
									<button class="ec-blockBtn--cancel btn_revise btn_sign_up_return" type="submit" name="mode" value="back" >戻る</button>
									<button class="ec-blockBtn--action btn_revise btn_sign_up" type="submit" name="mode" value="complete" >会員登録をする</button>
								</div>
							</div>
						</div>


					</ul>
				</div>

			</form>
		</div>
	</div>
{% endblock %}
