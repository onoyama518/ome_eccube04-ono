{% form_theme form 'Form/form_div_layout.twig' %}

<form method="get" class="searchform" action="{{ path('product_list') }}">
    {{ form_widget(form.name, {
        'id': null,
        'attr': {
            'class': 'search-name',
            'placeholder': '商品名・キーワードで検索',
        }
    }) }}
    <button type="submit" class="search-btn" style="background:none; border:none; cursor:pointer;">
        <img src="{{ asset('assets/img/search_icon.svg') }}" alt="検索">
    </button>
</form>
