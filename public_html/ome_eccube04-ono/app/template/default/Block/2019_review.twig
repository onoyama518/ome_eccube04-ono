		<div class="review-item">
			<a href="{{ url('product_detail', {'id': 299}) }}" id="review01">
				<div class="area_img">
					<img src="{{ asset('assets/img/renewal_top/review/ac-cleansing.png') }}" alt="{{ ReviewProduct01.name }}"/>
				</div>
			</a>
			<div class="area_info_item">
				<a href="{{ url('product_detail', {'id': 299}) }}" class="main_info" id="review01">
					<h3 class="item_name">{{ ReviewProduct01.name }}</h3>
					<span class="price">{{ ReviewProduct01.getPrice02IncTaxMin|number_format }}円<span class="tax">（税込）</span></span>
				</a>
         <div class="area_review">
					{{ render_review_block(299, RankingReviewAvgList, RankingReviewCountList)|raw }}
				</div>
				<div class="area_ex_review">
					<div class="icon_review">
						<img src="{{ asset('assets/img/renewal_top/review/icon.svg') }}" alt="人物アイコン" class="icon"/>
						<div class="info">
							<div class="ex_name">リピしてます！ </div>
							<img src="{{ asset('assets/img/renewal_top/review/star.svg') }}" alt="☆☆☆☆☆"/>
						</div>
					</div>
					<p class="ex_text">Wクレンジング不要今まで信じた事なかったですが、ACクレンジングはスッキリ！お客様も皆さん洗顔いらずで喜ばれます！</p>
				</div>
			</div>
			<div class="cart-form-area">
				{% if ReviewProduct01.stock_find %}
					<button type="button" class="btn btn_cart purchase-btn" data-product-id="299" onclick="openCartModal(299)">カートに入れる</button>
				{% else %}
					<button type="button" class="btn btn_cart purchase-btn" disabled aria-disabled="true">在庫切れ</button>
