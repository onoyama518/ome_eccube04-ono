<script>
  $(function () {
    var $onHeaderText = $('.on_header_text');
    var $headRenew = $('#head-renew');

    var updateHeaderState = function () {
      var scrollTop = $(window).scrollTop();

      // .on_header_text をスクロールしたら非表示
      if (scrollTop > 0) {
        $onHeaderText.addClass('hidden_text');
      } else {
        $onHeaderText.removeClass('hidden_text');
      }

      // 100pxスクロールしたら #head-renew の top を 0 に変更
      if (scrollTop > 0) {
        $headRenew.addClass('adjusted');
      } else {
        $headRenew.removeClass('adjusted');
      }
    };

    // スクロール時に更新
    $(window).on('scroll', updateHeaderState);
    // 初回ロード時に状態を反映（ページ内リンクやリロードで既にスクロール位置がある場合に対応）
    updateHeaderState();
  });
</script>