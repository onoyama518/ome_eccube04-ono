{% extends 'default_frame.twig' %}

{% set body_class = 'cart_page' %}

{% block main %}
	<div class="ec-role">
		<div class="ec-pageHeader">
			<h1>{{ 'ご注文完了'|trans }}</h1>
		</div>
	</div>

	<div class="ec-cartRole">
		<div class="ec-cartRole__progress">
			<ul class="ec-progress">
				{% set step = 1 %}
				<li class="ec-progress__item">
					<div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
					</div>
					<div class="ec-progress__label">{{ 'カートの商品'|trans }}
					</div>
				</li>
				{% if is_granted('ROLE_USER') == false %}
					<li class="ec-progress__item">
						<div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
						</div>
						<div class="ec-progress__label">{{ 'お客様情報'|trans }}
						</div>
					</li>
				{% endif %}
				<li class="ec-progress__item">
					<div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
					</div>
					<div class="ec-progress__label">{{ 'ご注文手続き'|trans }}
					</div>
				</li>
				<li class="ec-progress__item">
					<div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
					</div>
					<div class="ec-progress__label">{{ 'ご注文内容確認'|trans }}
					</div>
				</li>
				<li class="ec-progress__item  is-complete">
					<div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
					</div>
					<div class="ec-progress__label">{{ '完了'|trans }}
					</div>
				</li>
			</ul>
		</div>
	</div>

	<div class="ec-cartCompleteRole">
		<div class="ec-reportHeading">
			<h2>{{ 'ご注文ありがとうございました'|trans }}</h2>
		</div>
		<div class="ec-off3Grid ec-text-ac">
			<div class="ec-off3Grid__cell">
				<p class="ec-reportDescription">
					{{ '【omeエンタープライズ】まつげエクステ(マツエク)商材卸の商品をご購入いただき、ありがとうございました。
ただいま、ご注文の確認メールをお送りさせていただきました。
万一、ご確認メールが届かない場合は、トラブルの可能性もありますので大変お手数ではございますがもう一度お問い合わせいただくか、お電話にてお問い合わせくださいませ。
今後ともご愛顧賜りますようよろしくお願い申し上げます。
'|trans|nl2br }}
					<ul class="add-complete-banner">
						<li>
							<p class="top-text">
								▼友達追加で1,000円OFFクーポン配付中!!</p>
							<a href="https://lin.ee/b9CFnoC" target="_blank">
								<img src="{{ app.config.urlpath }}/user_data/packages/default/img_2018/bana/2019line_bana.jpg" alt="LINE@" width="230"/>
							</a>
							<p class="bt-text">LINE@のお友達募集中！お得情報が満載！</p>
						</li>
						<li>
							<a href="https://www.facebook.com/ome.shouzai/" target="_blank">
								<img src="{{ app.config.urlpath }}/user_data/packages/default/img_2018/bana/2019instagram_bana.jpg" alt="インスタグラム" width="230"/>
							</a>
							<p class="bt-text">omeの公式Instagramで最新情報を配信中！</p>
						</li>
					</ul>
					{% if Order.id %}
						<br/><br/><strong>{{ 'ご注文番号'|trans }}
							:
							{{ Order.orderNo }}</strong>
					{% endif %}
				</p>
				{% if Order.complete_message is not empty %}
					{{ Order.complete_message|raw|purify }}
				{% endif %}
			</div>
		</div>
		<div class="ec-reportDescription">
			<p>【omeエンタープライズ】まつげエクステ(マツエク)商材卸</p>
			<p>TEL：0120-965-583</p>
			<p>E-mail：info@ome-shouzai.com</p>
		</div>
		<div class="ec-off4Grid">
			{% if hasNextCart %}
								<a class="ec-blockBtn--action add-checkout-btn" href="{{ url('cart') }}">{{ '購入を続ける'|trans }}</a>
			{% else %}
								<a class="ec-blockBtn--action add-checkout-btn" href="{{ url('homepage') }}">{{ 'トップページへ'|trans }}</a>
			{% endif %}
		</div>
	</div>
{% endblock %}