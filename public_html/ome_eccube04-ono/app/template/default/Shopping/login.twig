{% extends 'default_frame.twig' %}

{% set body_class = 'cart_page' %}

{% block main %}
<div class="ec-role" id="under02column">
		<div class="ec-pageHeader">
			<h2 class="title">{{ '会員ページログイン'|trans }}</h2>
		</div>
		<div class="ec-off2Grid" id="under02column_login">
			<div class="ec-off2Grid__cell">
				<form name="login_mypage" id="shopping_login" method="post" action="{{ url('mypage_login') }}">
				<input type="hidden" name="_target_path" value="{{ url('shopping') }}" />
                    <input type="hidden" name="_failure_path" value="{{ url('shopping_login') }}" />
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
					<div class="ec-login login_area">

						<div class="ec-login__input inputbox">
							<div class="ec-input">
								<dl class="formlist clearfix">
									<dt>メールアドレス</dt>
									<dd>
										{{ form_widget(form.login_email, {'attr': {'class': 'box300', 'style' : 'ime-mode: disabled;', 'placeholder' : 'メールアドレス', 'autofocus': true}}) }}
										{% if BaseInfo.option_remember_me %}

											<p
												class="login_memory">
												<!--{assign var=key value="mypage_login_memory"}-->
												{% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
													<input type="hidden" name="login_memory" value="1">
												{% else %}
													{{ form_widget(form.login_memory, { 'label': 'メールアドレスを記憶させる'|trans },{'attr': {'class': 'area_login_mail'}}) }}
												{% endif %}
											</p>
										{% endif %}

									</dd>
								</dl>
								<dl class="formlist clearfix">
									<dt>

										パスワード
									</dt>
									<dd>
										{{ form_widget(form.login_pass, {'attr': {'class': 'box300', 'placeholder' : 'パスワード' }}) }}

									</dd>
								</dl>
							</div>

							{% for reset_complete in app.session.flashbag.get('password_reset_complete') %}
								<p>{{ reset_complete|trans }}</p>
							{% endfor %}
							{% if error %}
								<p class="ec-errorMessage">{{ error.messageKey|trans(error.messageData, 'validators')|nl2br }}</p>
							{% endif %}

						</div>

						<div class="ec-grid2__cell">
							<div class="ec-login__actions">
								<button type="submit" id="log" class="ec-blockBtn--cancel"><img src="{{asset('assets/img_2018/top/login_bar.png')}}" alt="ログイン"/></button>
							</div>
						</div>
						<p>
							※パスワードを忘れた方は<a href="{{ url('forgot') }}" class="attention">こちら</a>［再発行］<br/>
							※メールアドレスを忘れた方は、お手数ですが、<a href="{{ url('contact') }}" class="attention">お問い合わせページ</a>からお問い合わせください。
						</p>

					</div>
					<div class="login_area">
						<h3>はじめてご利用の方</h3>
						<div class="btn_area">
							<ul>
								<a href="{{url('help_agreement')}}" id="log2"><img src="{{asset('assets/img_2018/top/touroku_bar.png')}}" alt="会員登録をする"/></a>
							</ul>
						</div>
						<p class="inputtext">オンラインショップをご利用いただくには、会員登録が必要です。新規会員登録ですぐに使える<span style="color:red">500Pをプレゼント</span>いたします。


						</p>
					</div>
					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
				</form>
			</div>
		</div>
	</div>
{% endblock %}