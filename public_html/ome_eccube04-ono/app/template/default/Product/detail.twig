{% extends 'default_frame.twig' %}

{% set body_class = 'product_page' %}


{% block stylesheet %}
	<style>

		.slick-slider {
			margin-bottom: 30px;
		}

		.slick-dots {
			position: absolute;
			bottom: -45px;
			display: block;
			width: 100%;
			padding: 0;
			list-style: none;
			text-align: center;
		}

		.slick-dots li {
			position: relative;
			display: inline-block;
			width: 20px;
			height: 20px;
			margin: 0 5px;
			padding: 0;

			cursor: pointer;
		}

		.slick-dots li button {
			font-size: 0;
			line-height: 0;
			display: block;
			width: 20px;
			height: 20px;
			padding: 5px;
			cursor: pointer;
			color: transparent;
			border: 0;
			outline: none;
			background: transparent;
		}

		.slick-dots li button:hover,
		.slick-dots li button:focus {
			outline: none;
		}

		.slick-dots li button:hover:before,
		.slick-dots li button:focus:before {
			opacity: 1;
		}

		.slick-dots li button:before {
			content: " ";
			line-height: 20px;
			position: absolute;
			top: 0;
			left: 0;
			width: 12px;
			height: 12px;
			text-align: center;
			opacity: .25;
			background-color: black;
			border-radius: 50%;

		}

		.slick-dots li.slick-active button:before {
			opacity: .75;
			background-color: black;
		}

		.slick-dots li button.thumbnail img {
			width: 0;
			height: 0;
		}
		/* モーダル全体 */
		.ec-modal {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			z-index: 1000;
			display: none;
			background: rgba(0, 0, 0, 0.5); /* 背景を半透明 */
		}

		/* モーダルの中央部分 */
		.ec-modal-wrap {
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			background: #fff;
			padding: 40px; /* パディングを広げて空白を確保 */
			box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
			border-radius: 8px;
			width: 90%;
			max-width: 550px; /* 最大幅を調整 */
			text-align: center;
		}


		/* モーダル内のコンテンツ */
		.ec-modal-content {
			position: relative;
			font-size: 18px; /* 文字を少し大きめに */
			line-height: 1.6; /* 行間を調整して読みやすく */
			color: #333; /* 濃い文字色で視認性を向上 */
		}
		#ec-modal-header {
			font-size: 26px; /* タイトルを大きめに */
			margin-bottom: 20px;
			font-weight: bold;
			color: #333;
		}

		/* ボタンの配置 */
		.modal-buttons {
			display: flex;
			justify-content: center;
			gap: 20px; /* ボタン間の空白を広げる */
			margin-top: 20px; /* ボタン上部の余白を調整 */
		}

		/* ボタンの基本スタイル */
		.modal-btn {
			width: 210px;
			padding: 12px 30px; /* ボタンを大きめに */
			border: none;
			border-radius: 4px;
			font-size: 18px; /* ボタン内の文字を大きめに */
			cursor: pointer;
			font-weight: bold;
		}

		/* 「買い物を続ける」ボタン */
		#continue-shopping {
			background-color: #525263;
			color: #fff;
			cursor: pointer;

		}

		#continue-shopping:hover {
			opacity: 0.8;
		}

		/* 「カートに移動する」ボタン */
		#go-to-cart {
			background-color: #ff8b3b;
			color: #fff;
			cursor: pointer;
		}

		#go-to-cart:hover {
			opacity: 0.8;
		}

		/* 「最近見た商品」のセクション */
		.recently-viewed {
			margin-top: 30px; /* 上部余白を調整 */
			text-align: center;
		}

		/* 「最近見た商品」のタイトル */
		.recently-viewed h3 {
			font-size: 20px; /* タイトルを大きめに */
			margin-bottom: 20px;
			font-weight: bold;
			color: #333; /* タイトルの文字色を濃く */
		}

		/* 商品リスト全体 */
		.recommend-carousel {
			display: flex;
			justify-content: center; /* 商品を中央揃え */
			gap: 30px; /* 商品間の間隔を広げる */
			padding: 20px 0; /* 上下の余白を追加 */
			margin: 0 auto;
			width: 100%;
		}

		/* 商品1つ分のスタイル */
		.recommend-carousel ul li {
			flex: 1;
			max-width: 150px; /* 商品の幅を調整 */
			text-align: center;
			font-weight: bold;
		}

		/* 商品画像のスタイル */
		.recommend-carousel ul li img {
			width: 100%; /* 画像を親要素の幅に合わせる */
			height: auto;
			display: block;
			margin: 0 auto 10px; /* 下部に余白を追加 */
			border: 1px solid #ddd;
			border-radius: 4px;
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
		}

		/* 商品名のスタイル */
		.recommend-item-text {
			font-size: 13px; /* 商品名を大きめに */
			color: #333;
			margin-top: 10px;
			line-height: 1.4;
			white-space: normal; /* 商品名を折り返し可能に */
			overflow: hidden; /* テキストオーバーフローを隠す */
			text-align: center;
			font-weight: bold;

		}

		/* 閉じるボタン */
		.ec-modal-close {

			margin-top: 30px; /* 上部に余白を追加 */
			padding: 12px 30px; /* 閉じるボタンを大きめに */
			background: #6c757d;
			color: white;
			border: none;
			border-radius: 4px;
			font-size: 18px; /* ボタンの文字サイズを拡大 */
			cursor: pointer;

		}

		.ec-modal-close:hover {
			background: #5a6268;
		}
		.br_recent_sp {
			display: none;
		}

		@media screen and(max-width:768px) {
			.modal-btn {
				padding: 12px 30px; /* ボタンを大きめに */
				border: none;
				border-radius: 4px;
				font-size: 14px; /* ボタン内の文字を大きめに */
				cursor: pointer;
				font-weight: bold;
			}
			#ec-modal-header {
				font-size: 20px; /* タイトルを大きめに */
				margin-bottom: 20px;
				font-weight: bold;
				color: #333;
			}
			.recommend-carousel {
				padding: 0 !important;
				gap: 15px;
			}
			.recommend-carousel li {
				max-width: 150px !important;
				width: 33%;
			}
			.recent_item_thumb {
				max-width: 150px !important;

			}
			.recommend-item-text {
				font-size: 12px;
			}
			.all_delete {
				display: none;
			}
			.br_recent_sp {
				display: block;
			}
			.ec-modal-wrap {
				width: 80%;
				padding: 20px;
			}
		}
	</style>
{% endblock %}

{% block javascript %}
	<script>
		// 規格2に選択肢を割り当てる関数
eccube.classCategories = {{ class_categories_as_json(Product)|raw }};
function fnSetClassCategories(form, classcat_id2_selected) {
var $form = $(form);
var product_id = $form.find('input[name=product_id]').val();
var $sele1 = $form.find('select[name=classcategory_id1]');
var $sele2 = $form.find('select[name=classcategory_id2]');
eccube.setClassCategories($form, product_id, $sele1, $sele2, classcat_id2_selected);
}

{% if form.classcategory_id2 is defined %}fnSetClassCategories($('#form1'), {{ form.classcategory_id2.vars.value|json_encode|raw }});
{% elseif form.classcategory_id1 is defined %}
eccube.checkStock($('#form1'), {{ Product.id }}, {{ form.classcategory_id1.vars.value|json_encode|raw }}, null);{% endif %}
	</script>

	<script>
		$(function () { // ページキャッシュ無効化対策
$(window).bind('pageshow', function (event) {
if (event.originalEvent.persisted) {
location.reload(true);
}
});

// 画像の枚数を取得
var imageCount = $('.item_visual .slide-item').length;

// メインビジュアルのスライダー設定
if (imageCount >= 5) { // 5枚以上の場合は通常のスライダー（無限ループあり）
$('.item_visual').slick({
dots: false,
arrows: false,
slidesToShow: 1,
infinite: true,
asNavFor: ".mini-slider",
fade: true,
cssEase: 'linear',
swipe: true,
draggable: true,
touchMove: true
});

// サムネイルスライダーの設定（5枚以上の場合）
$('.mini-slider').slick({
dots: false,
arrows: false,
slidesToShow: 4,
infinite: true,
asNavFor: ".item_visual",
focusOnSelect: true
});
} else { // 4枚以下の場合のメインビジュアル設定
$('.item_visual').slick({
dots: false,
arrows: false,
slidesToShow: 1,
infinite: false,
fade: true,
cssEase: 'linear',
swipe: true,
draggable: true,
touchMove: true
});

// 4枚以下の場合のサムネイル設定
$('.mini-slider').slick({
dots: false,
arrows: false,
slidesToShow: 4,
infinite: false,
focusOnSelect: true,
swipe: false,
draggable: false,
touchMove: false
});

// メインビジュアルのスライド時にサムネイルのアクティブ状態を手動で更新
$('.item_visual').on('beforeChange', function (event, slick, currentSlide, nextSlide) {
$('.mini-slider .slick-slide').removeClass('slick-current');
$('.mini-slider .slick-slide[data-slick-index="' + nextSlide + '"]').addClass('slick-current');
});

// サムネイルクリック時のメインビジュアル切り替え
$('.mini-slider .slide-items').on('click', function () {
var index = $(this).data('slick-index');
$('.item_visual').slick('slickGoTo', index);
});
}
});
	</script>

	<script>
		$(function () {
function checkCategorySelection() {
var $sele1 = $('#classcategory_id1'); // 規格1の要素
var $sele2 = $('#classcategory_id2'); // 規格2の要素
var label1 = $('label[for="classcategory_id1"]').text().trim() || '規格1';
var label2 = $('label[for="classcategory_id2"]').text().trim() || '規格2';

// カスタムエラーメッセージをリセット
$sele1[0].setCustomValidity('');
if ($sele2.length > 0) { // 規格2が存在する場合にリセット
$sele2[0].setCustomValidity('');
}

// 規格1が未選択かつ規格2が存在しない場合
if ($sele1.val() === "__unselected" && ($sele2.length === 0 || $sele2.val() == null)) {
$sele1[0].setCustomValidity (`「${label1}」が選択されていません`);
}
// 規格1が未選択で、規格2が未選択の場合
else if ($sele1.val() === "__unselected" && ! $sele2.val()) {
$sele1[0].setCustomValidity (`「${label1}」が選択されていません`);
$sele2[0].setCustomValidity (`「${label2}」が選択されていません`);
}
// 規格1が選択されていて、規格2が未選択の場合
else if ($sele1.val() !== "__unselected" && ! $sele2.val()) {
$sele2[0].setCustomValidity (`「${label2}」が選択されていません`);
}

// フォーム全体のバリデーションを確認
var form = $sele1.closest('form')[0];
if (form && ! form.checkValidity()) {
form.reportValidity(); // 標準のエラーメッセージを表示
}
}


// カートに追加する処理

$('.add-cart').on('click', function (event) { // フォーム送信のAjax化
var $form = $('#form1');
$.ajax({
url: $form.attr('action'),
type: $form.attr('method'),
data: $form.serialize(),
dataType: 'json',
beforeSend: function () {
$('.add-cart').prop('disabled', true); // ボタンを無効化
$('#validate_class_1').text(''); // エラーメッセージをクリア
}
}).done(function (data) { // モーダルでメッセージ表示
$('#ec-modal-header').text('カートに商品が入りました'); // メッセージを設定
$('.ec-modal').fadeIn();
// モーダルを表示

// カートブロック更新
$.ajax({url: "{{ url('block_cart') }}", type: 'GET', dataType: 'html'}).done(function (html) {
$('.ec-headerRole__cart').html(html); // カートブロックを更新
});
}).fail(function () {

checkCategorySelection();
}).always(function () {
$('.add-cart').prop('disabled', false); // ボタンを有効化
});
});

// 「買い物を続ける」ボタンの動作
$('#continue-shopping').on('click', function () {
$('.ec-modal').fadeOut(); // モーダルを閉じる
});

// 「カートへ進む」ボタンの動作
$('#go-to-cart').on('click', function () {
window.location.href = "{{ url('cart') }}"; // カートページへ遷移
});

// モーダル外クリックで閉じる
$('.ec-modal-overlay, .ec-modal-close').on('click', function () {
$('.ec-modal').fadeOut(); // モーダルを閉じる
});
});


document.addEventListener('DOMContentLoaded', function () { // <br> を削除し、\n を <br> に変換する関数
function processDescription(element) {
if (! element) 
return;



const tableElements = Array.from(element.querySelectorAll('table'));
const placeholders = [];

// プレースホルダで table を DOMごと一時置換
tableElements.forEach((table, index) => {
const placeholder = document.createComment (`TABLE-${index}`);
placeholders.push({placeholder, table});
table.replaceWith(placeholder);
});

// <br> を削除し、\n を <br> に変換
let updatedContent = element.innerHTML.replace(/<br\s*\/?>/gi, '').replace(/\n/g, '<br>');

// 更新後の HTML を適用
element.innerHTML = updatedContent;

// プレースホルダを元の table に戻す
placeholders.forEach(({placeholder, table}) => {
const commentNodes = Array.from(element.childNodes).filter(n => n.nodeType === Node.COMMENT_NODE && n.data === placeholder.data);
commentNodes.forEach(comment => comment.replaceWith(table));
});
}


// 最初の <br> を削除する関数
function removeFirstBr(element) {
if (! element) 
return;



const firstBr = element.querySelector('br');
if (firstBr) 
firstBr.remove();



}

// 特定の要素の直後や直前の <br> を削除
function removeBr(container) {
if (! container) 
return;



// 特定の要素の直後の <br> を削除
function removeBrAfterElement(elements) {
elements.forEach(element => {
const nextSibling = element.nextSibling;
if (nextSibling && nextSibling.nodeType === Node.ELEMENT_NODE && nextSibling.tagName === 'BR') {
nextSibling.remove();
}
});
}

// h4 の直後の <br> を削除
removeBrAfterElement(container.querySelectorAll('h4'));

// h3 の直後の <br> を削除
removeBrAfterElement(container.querySelectorAll('h3'));

// ul 内の <br> を削除
const ulElements = container.querySelectorAll('ul');
ulElements.forEach(ul => {
ul.querySelectorAll('br').forEach(br => br.remove());
});

// 最初の h4 の直前の <br> を削除
const firstH4 = container.querySelector('h4');
if (firstH4) {
const previousSibling = firstH4.previousSibling;
if (previousSibling && previousSibling.nodeType === Node.ELEMENT_NODE && previousSibling.tagName === 'BR') {
previousSibling.remove();
}
}
}

// 処理対象の要素
const descriptionMain = document.querySelector('.ec-productRole__description');

if (descriptionMain) { // 全体的な不要な改行の処理
processDescription(descriptionMain);

// 最初の <br> を削除
removeFirstBr(descriptionMain);

// 特定の <br> を削除
removeBr(descriptionMain);
}
});
	</script>


	<script type="application/ld+json">
		{
																									"@context": "https://schema.org/",
																									"@type": "Product",
																									"name": "{{ Product.name }}",
																									"image": [
		{% for img in Product.ProductImage %}
			"{{ app.request.schemeAndHttpHost }}{{ asset(img, 'save_image') }}"
			{% if not loop.last %},
			{% endif %}
		{% else %}
			"{{ app.request.schemeAndHttpHost }}{{ asset(''|no_image_product, 'save_image') }}"
		{% endfor %}
		],
																									"description": "{{ Product.description_list | default(Product.description_detail) | replace({'\n': '', '\r': ''}) | slice(0,300) }}",
		{% if Product.code_min %}
			"sku": "{{ Product.code_min }}",
		{% endif %}
		"offers": {
																										"@type": "Offer",
																										"url": "{{ url('product_detail', {'id': Product.id}) }}",
																										"priceCurrency": "{{ eccube_config.currency }}",
																										"price":
		{{ Product.getPrice02IncTaxMin ? Product.getPrice02IncTaxMin : 0 }},
																										"availability": "{{ Product.stock_find ? "InStock" : "OutOfStock" }}"
																									}
																								}
	</script>
