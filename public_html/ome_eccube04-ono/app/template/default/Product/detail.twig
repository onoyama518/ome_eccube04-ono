{% block main %}
	<div class="ec-modal" style="display: none;">
		<div class="ec-modal-overlay"></div>
		<div class="ec-modal-wrap">
			<div class="ec-modal-content">
				<h2 id="ec-modal-header" style="text-align:center;">最近見た商品</h2>
				<div class="modal-buttons">
					<button id="continue-shopping" class="modal-btn">買い物を<br class="br_recent_sp">続ける</button>
					<button id="go-to-cart" class="modal-btn">カートに<br class="br_recent_sp">移動する</button>
				</div>
				{% set recent_products = app.session.get('recent_products', []) %}
				{% if recent_products|length > 1 %}
					<div class="recently-viewed">
						<h3>最近見た商品</h3>
						<ul class="recommend-carousel">
							{% for product in recent_products %}
								<li style="width:100%; max-width:150px; {% if loop.first %}display:none;{% endif %}">
									<a href="{{ url('product_detail', {'id': product.id}) }}">
										{% if product.image %}
											<img src="{{ '/html/upload/save_image/' ~ (product.image | replace({'default/upload/save_image/': ''})) }}" alt="{{ product.name }}" class="recent_item_thumb" style="width:100%;">
										{% else %}
											<img src="{{ asset('assets/img/no_image.png') }}" alt="No Image">
										{% endif %}
										<p class="recommend-item-text">{{ product.name }}</p>
									</a>
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}
				<button class="ec-modal-close">閉じる</button>

			</div>
		</div>
	</div>

	<div class="ec-productRole" id="undercolumn_pages">
		<div class="ec-grid2 clearfix" id="detailarea">
			<div class="relative_cat">関連カテゴリ：
				{% for ProductCategory in Product.ProductCategories %}

					{% for Category in ProductCategory.Category.path %}
						<a href="{{ url('product_list') }}?category_id={{ Category.id }}">{{ Category.name }}</a>
						{%- if loop.last == false %}
							<span>＞</span>
						{% endif -%}
					{% endfor %}

				{% endfor %}

			</div>
			<div class="ec-grid2__cell" id="detailphotobloc">
				<div class="ec-sliderItemRole photo">

					<div class="item_visual expansion" id="openModal">
						{% for ProductImage in Product.ProductImage %}
							<div class="slide-item" style="cursor:pointer;"><img class="picture " src="{{ asset(ProductImage, 'save_image') }}" alt="{{ loop.first ? Product.name : '' }}" {% if loop.index > 1 %} loading="lazy" {% endif %}></div>
						{% else %}
							<div class="slide-item"><img class="picture pinch-zoom" src="{{ asset(''|no_image_product, 'save_image') }}" alt="{{ loop.first ? Product.name : '' }}"></div>
						{% endfor %}
					</div>

					{% if Product.ProductImage|length > 1 %}
						<div class="mini-slider">
							{% for ProductImage in Product.ProductImage %}
								<div class="slide-items" style="cursor:pointer;"><img class="picture" src="{{ asset(ProductImage, 'save_image') }}" alt="{{ loop.first ? Product.name : '' }}" {% if loop.index > 1 %} loading="lazy" {% endif %}></div>
							{% else %}
								<div class="slide-items"><img class="picture" src="{{ asset(''|no_image_product, 'save_image') }}" alt="{{ loop.first ? Product.name : '' }}"></div>
							{% endfor %}
						</div>
					{% endif %}

				</div>
				<p align="left">
					<span
						class="mini">
						<!--★拡大する★-->
						<button class="expansion" id="button_open_modal">
							画像を拡大する</button>
					</span>
				</p>
				<!-- モーダル -->
				<div id="modal" class="modal">
					<div class="modal-content">
						<span id="closeModal" class="close">&times;</span>
						<div class="modal_expand">
							{% for ProductImage in Product.ProductImage %}
								<div class="slide-item">
									<img class="picture pinch-zoom" src="{{ asset(ProductImage, 'save_image') }}" alt="{{ loop.first ? Product.name : '' }}" {% if loop.index > 1 %} loading="lazy" {% endif %}>
								</div>
							{% else %}
								<div class="slide-item">
									<img class="picture pinch-zoom" src="{{ asset(''|no_image_product, 'save_image') }}" alt="{{ loop.first ? Product.name : '' }}">
								</div>
							{% endfor %}
						</div>
					</div>
				</div>

				<script>
					// Slickスライダーの初期化
// ボタンとモーダルの要素を取得
const openModalButton = document.getElementById('openModal');
const openModalButton2 = document.getElementById('button_open_modal');
const modal = document.getElementById('modal');
const closeModalButton = document.getElementById('closeModal');

// モーダルを開く関数
const openModal = () => {
modal.style.display = 'block';

// メインスライダーの現在スライドを取得
const currentIndex = $('.item_visual').slick('slickCurrentSlide');

// 既存のモーダルスライダーを破棄して再初期化
if ($('.modal_expand').hasClass('slick-initialized')) {
$('.modal_expand').slick('unslick');
}

// 再初期化（initialSlide で開始位置を指定）
$('.modal_expand').slick({
dots: false,
arrows: true, // 矢印を有効化
slidesToShow: 1,
infinite: true,
fade: true, // フェード効果を有効化
cssEase: 'linear', // フェードアニメーションのスタイル
initialSlide: currentIndex, // ←ここで開始スライドを指定
prevArrow: '<button type="button" class="slick-prev">←</button>', // 左矢印
nextArrow: '<button type="button" class="slick-next">→</button>' // 右矢印
});
};

// ボタンイベントリスナーの追加
if (openModalButton) {
openModalButton.addEventListener('click', openModal);
}
if (openModalButton2) {
openModalButton2.addEventListener('click', openModal);
}

// モーダルを閉じる
if (closeModalButton) {
closeModalButton.addEventListener('click', () => {
modal.style.display = 'none';
});
}

// モーダルの外側をクリックしたときに閉じる
window.addEventListener('click', (event) => {
if (event.target === modal) {
modal.style.display = 'none';
}
});

// スマホ対応: 矢印タップの効きを改善
$(document).on('touchstart', '.slick-prev, .slick-next', function (e) {
e.stopPropagation(); // イベントの伝播を防止
e.preventDefault(); // デフォルトの動作を無効化
$(this).trigger('click'); // 明示的にクリックイベントを発火
});

document.addEventListener("DOMContentLoaded", function () {
const quantityInput = document.getElementById('quantity');
const minusButton = document.querySelector('.cart_minus');
const plusButton = document.querySelector('.cart_plus');

// 数量の更新
function updateQuantity() {
let currentValue = parseInt(quantityInput.value, 10);

// 「-」ボタンの制御（数量が1のとき無効化）
if (currentValue <= 1) {
minusButton.classList.add('not_zero');
} else {
minusButton.classList.remove('not_zero');
}


}

// 数量を減らす
minusButton.addEventListener('click', function () {
let currentValue = parseInt(quantityInput.value, 10);
if (currentValue > 1) {
quantityInput.value = currentValue - 1;
updateQuantity();
}
});

// 数量を増やす
plusButton.addEventListener('click', function () {
let currentValue = parseInt(quantityInput.value, 10);

quantityInput.value = currentValue + 1;
updateQuantity();
});

// 初期状態を確認
updateQuantity();
});
				</script>


