		{% include('@common/lang.twig') %}
		<script src="{{ asset('assets/js/function.js') }}"></script>
		<script src="{{ asset('assets/js/sp.js') }}"></script>
		<script src="{{ asset('assets/js/footer.js') }}"></script>
		<script src="{{ asset('assets/js/cart-ajax.js') }}"></script>
