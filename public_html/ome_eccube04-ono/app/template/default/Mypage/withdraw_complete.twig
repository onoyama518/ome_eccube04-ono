						またのご利用を心よりお待ち申し上げます。
					</div>
				</div>
				<div class="shop_information">
					<p class="name">株式会社kichi</p>
					<p>TEL：0120-965-583<br/>E-mail：<a href="mailto:info@ome-shouzai.com">info@ome-shouzai.com</a>
					</p>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
