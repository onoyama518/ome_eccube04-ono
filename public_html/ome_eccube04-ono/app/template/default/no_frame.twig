																				</div> #}
		{% include('@common/lang.twig') %}
		<script src="{{ asset('assets/js/function.js') }}"></script>
		<script src="{{ asset('assets/js/sp.js') }}"></script>
		<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
		<script src="{{ asset('assets/js/eccube.js') }}"></script>
		{% block javascript %}{% endblock %}
		{# Layout: CLOSE_BODY_BEFORE #}
		{% if Layout.CloseBodyBefore %}
			{{ include('block.twig', {'Blocks': Layout.CloseBodyBefore}) }}
		{% endif %}
		{# プラグイン用Snippet #}
		{# {% if plugin_snippets is defined %}
																			{{ include('snippet.twig', { snippets: plugin_snippets }) }}
																		{% endif %} #}
		<script>
			(function (window, document) {
				var root = document.documentElement;
				var showPage = function () {
					root.classList.remove('fonts-loading');
				};

				if (!window.Promise || !document.fonts) {
					showPage();
					return;
				}

				var timeout = window.setTimeout(showPage, 4000);
				var sampleText = 'まつげエクステ商材卸 ome エンタープライズ TOPページ 日本語 English 0123456789';
				sampleText = '\u307e\u3064\u3052\u30a8\u30af\u30b9\u30c6\u5546\u6750\u5378 ome \u30a8\u30f3\u30bf\u30fc\u30d7\u30e9\u30a4\u30ba TOP\u30da\u30fc\u30b8 \u65e5\u672c\u8a9e English 0123456789';
				var fontLoads = [];
				var loadFont = function (weight, family) {
					fontLoads.push(document.fonts.load(weight + ' 1em "' + family + '"', sampleText));
				};

				['300','400', '500', '600', '700'].forEach(function (weight) {
					[
						'source-han-sans-japanese',
						'yu-gothic-pr6n',
						'Yu Gothic Pr6N',
						'Josefin Sans',
						'Zen Kaku Gothic New',
						'Montserrat',
						'Poppins',
						'M PLUS Rounded 1c'
					].forEach(function (family) {
						loadFont(weight, family);
					});
				});

				['300','400', '500', '600', '700'].forEach(function (weight) {
					[
						'yu-mincho-pr6n',
						'cormorant-garamond',
						'Cormorant Garamond'
					].forEach(function (family) {
						loadFont(weight, family);
					});
				});

				Promise.all(fontLoads)
					.catch(function () {})
					.then(function () {
						return document.fonts.ready;
					})
					.catch(function () {})
					.then(function () {
						window.clearTimeout(timeout);
						window.requestAnimationFrame(showPage);
					});
			})(window, document);
		</script>
		<script src="{{ asset('assets/js/customize.js', 'user_data') }}"></script>
	</body>
</html>
